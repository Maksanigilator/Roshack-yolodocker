<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Профиль транспорта Fast DDS. КОПИЯ файла из проекта Nav_Test
  (fastdds_profiles.xml в его корне) — оба контейнера обязаны говорить
  на одинаковых настройках транспорта, иначе кадры между ними не пойдут.
  Если правится там, надо править и здесь.

  Подключается переменной FASTDDS_DEFAULT_PROFILES_FILE, см. службу
  rail_mask в docker-compose.yml.

  ЗАЧЕМ. По умолчанию Fast DDS заводит сегмент разделяемой памяти около
  512 КБ (замерено: 549408 байт). Кадр камеры 848x480 весит 1.22 МБ в цвете
  и 1.63 МБ в глубине — то есть втрое больше сегмента. Сообщение туда
  не помещается, разделяемая память для него не используется, и результат
  выходит ХУЖЕ, чем на чистом UDP: 22-23 Гц вместо 30 при том же потоке.

  Здесь сегмент поднят до 64 МБ, а предельный размер сообщения до 8 МБ —
  с запасом на глубину 1.63 МБ и на несколько кадров в очереди.

  ВАЖНО про useBuiltinTransports=false: с ним используются ТОЛЬКО объявленные
  ниже транспорты. Поэтому UDPv4 объявлен явно и остаётся на месте — без него
  оборвалась бы связь со всем, что не на этой машине, в том числе с реальным
  роботом на этапе 6.

  Разделяемая память работает, только когда обе стороны запущены под ОДНИМ
  пользователем: Fast DDS создаёт файлы в /dev/shm с правами 0644 и владельцем-
  создателем, принудительно, игнорируя umask. Ради этого контейнер и запускается
  с флагом user, подробности в docker/Dockerfile.
-->
<dds xmlns="http://www.eprosima.com">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>shm_large</transport_id>
                <type>SHM</type>
                <!-- 64 МБ: вмещает десяток кадров глубины в очереди -->
                <segment_size>67108864</segment_size>
                <!-- 8 МБ: глубина 848x480 float32 это 1.63 МБ, запас четырёхкратный -->
                <maxMessageSize>8388608</maxMessageSize>
            </transport_descriptor>
            <transport_descriptor>
                <transport_id>udp_transport</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="nav_test_default" is_default_profile="true">
            <rtps>
                <userTransports>
                    <transport_id>shm_large</transport_id>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <useBuiltinTransports>false</useBuiltinTransports>
            </rtps>
        </participant>
    </profiles>
</dds>
